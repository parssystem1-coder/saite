# ─────────────────────────────────────────
# متغیرهای محیطی — saite
# ─────────────────────────────────────────
# این فایل را با نام .env.local کپی کنید و مقادیر واقعی را پر کنید.
# cp .env.example .env.local

# ─── عمومی ───────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Saite

# ─── لایهٔ داده (فرانت) ──────────────────
# پیش‌فرض: mock داخلی. برای HTTP واقعی:
# NEXT_PUBLIC_USE_MOCK=false
# NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
NEXT_PUBLIC_USE_MOCK=true
# NEXT_PUBLIC_API_BASE_URL=

# ─── دیتابیس ─────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/saite

# ─── ورود مدیر ───────────────────────────
# اعتبارنامهٔ پنل مدیریت. اگر تعریف نکنید، مقدار پیش‌فرض کد
# استفاده می‌شود:  admin / saite-demo-1404
#
# ✅ این نام‌ها عمداً پیشوند NEXT_PUBLIC ندارند — یعنی فقط روی
#    سرور خوانده می‌شوند و وارد باندل مرورگر نمی‌شوند.
#
#    نسخهٔ قبلی NEXT_PUBLIC_ADMIN_PASSWORD بود که رمز را داخل
#    جاوااسکریپت مرورگر می‌گذاشت. با این دستور قابل اثبات بود:
#      npm run build && grep -rl "saite-demo-1404" .next/static
#    حالا آن جستجو خالی برمی‌گردد.
#
# ⚠️ رمز همچنان متن ساده است، نه هش. برای production واقعی باید
#    به دیتابیس با bcrypt/argon2 منتقل شود.
# ADMIN_USERNAME=myname
# ADMIN_PASSWORD=my-strong-passphrase

# ─── کلید امضای نشست مدیر ────────────────
# کوکی نشست با HMAC-SHA256 امضا می‌شود تا قابل جعل نباشد.
#
# در توسعهٔ محلی اختیاری است (مقدار پیش‌فرض استفاده می‌شود)، اما
# در production **الزامی** است: اگر تعریف نشده باشد، برنامه
# عمداً با خطا بالا نمی‌آید — چون بدون آن هر کسی که سورس را دیده
# می‌تواند کوکی مدیر بسازد.
#
# ساخت مقدار تصادفی:
#   openssl rand -base64 32
# ADMIN_SESSION_SECRET=

# ─── احراز هویت ──────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-here

# ─── پرداخت (زرین‌پال / IDPay) ───────────
PAYMENT_API_KEY=your-payment-api-key
PAYMENT_SANDBOX=true

# ─── آپلود تصاویر ────────────────────────
# گزینه‌ها: local, s3, cloudinary
UPLOAD_PROVIDER=local
# UPLOAD_S3_BUCKET=
# UPLOAD_S3_REGION=
# UPLOAD_CLOUDINARY_URL=

# ─── ایمیل ───────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
