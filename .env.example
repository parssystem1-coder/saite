# ─────────────────────────────────────────
# متغیرهای محیطی — saite
# ─────────────────────────────────────────
# این فایل را با نام .env.local کپی کنید و مقادیر واقعی را پر کنید.
# cp .env.example .env.local

# ─── عمومی ───────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Saite

# ─── لایهٔ داده (فرانت) ──────────────────
# پیش‌فرض: mock داخلی. برای HTTP واقعی:
# NEXT_PUBLIC_USE_MOCK=false
# NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
NEXT_PUBLIC_USE_MOCK=true
# NEXT_PUBLIC_API_BASE_URL=

# ─── دیتابیس ─────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/saite

# ─── ورود مدیر (فقط فاز توسعه) ───────────
# تا وقتی بک‌اند متصل نشده، اعتبارنامهٔ پنل از اینجا خوانده می‌شود.
# اگر تعریف نکنید، مقدار پیش‌فرض کد استفاده می‌شود:
#   admin / saite-demo-1404
#
# ⚠️ پیشوند NEXT_PUBLIC یعنی مقدار در باندل مرورگر قرار می‌گیرد و
#    قابل خواندن است. این فقط برای عوض‌کردن مقدار پیش‌فرض در محیط
#    توسعه است، نه امنیت واقعی. رمز شخصی خود را اینجا نگذارید.
#
# پس از اتصال بک‌اند این دو حذف می‌شوند و رمز هش‌شده در دیتابیس
# نگهداری خواهد شد.
# NEXT_PUBLIC_ADMIN_USERNAME=myname
# NEXT_PUBLIC_ADMIN_PASSWORD=my-strong-passphrase

# ─── احراز هویت ──────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-here

# ─── پرداخت (زرین‌پال / IDPay) ───────────
PAYMENT_API_KEY=your-payment-api-key
PAYMENT_SANDBOX=true

# ─── آپلود تصاویر ────────────────────────
# گزینه‌ها: local, s3, cloudinary
UPLOAD_PROVIDER=local
# UPLOAD_S3_BUCKET=
# UPLOAD_S3_REGION=
# UPLOAD_CLOUDINARY_URL=

# ─── ایمیل ───────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
