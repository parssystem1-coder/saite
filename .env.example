# ─────────────────────────────────────────
# متغیرهای محیطی — saite
# ─────────────────────────────────────────
# این فایل را با نام .env.local کپی کنید و مقادیر واقعی را پر کنید.
# cp .env.example .env.local
#
# ⚠️ متغیرهایی که پایین‌تر زیر «هنوز متصل نیست» آمده‌اند، در کد
#    فعلی **خوانده نمی‌شوند**. عمداً کامنت شده‌اند: متغیر فعالِ
#    بی‌مصرف این توهم را می‌سازد که چیزی پیکربندی شده، در حالی که
#    هیچ کدی سراغش نمی‌رود.

# ─── عمومی ───────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Saite

# ─── لایهٔ داده (فرانت) ──────────────────
# پیش‌فرض: mock داخلی. برای HTTP واقعی:
# NEXT_PUBLIC_USE_MOCK=false
# NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
#
# نکته: اگر base URL روی دامنهٔ دیگری باشد، همان origin به‌صورت
# خودکار به connect-src در CSP اضافه می‌شود (src/lib/security-headers.ts).
NEXT_PUBLIC_USE_MOCK=true
# NEXT_PUBLIC_API_BASE_URL=

# ─── ورود مدیر ───────────────────────────
# 🔴 در production این دو **الزامی** هستند.
#
# تا پیش از این، نبودشان فقط هشدار می‌داد و مقدار پیش‌فرض
# admin / saite-demo-1404 فعال می‌ماند — رمزی که در مخزن عمومی
# نوشته شده. حالا اگر تعریف نشوند، ورود به پنل در production با
# خطای ۵۰۳ بسته می‌شود.
#
# ✅ این نام‌ها عمداً پیشوند NEXT_PUBLIC ندارند — یعنی فقط روی
#    سرور خوانده می‌شوند و وارد باندل مرورگر نمی‌شوند.
# ADMIN_USERNAME=myname
# ADMIN_PASSWORD=my-strong-passphrase

# ─── رمز هش‌شده (توصیه‌شده برای انتشار) ──
# ADMIN_PASSWORD می‌تواند به‌جای متن ساده، هش scrypt باشد:
#
#   npm run admin:hash-password
#
# خروجی چیزی شبیه این است:
#   ADMIN_PASSWORD=scrypt.16384.8.1.<salt>.<hash>
#
# تشخیص خودکار است. از روی هش نمی‌توان رمز را بازیابی کرد.

# ─── کلید امضای نشست مدیر ────────────────
# کوکی نشست با HMAC-SHA256 امضا می‌شود تا قابل جعل نباشد.
# در توسعه اختیاری، در production الزامی.
#
#   npm run admin:secret
# ADMIN_SESSION_SECRET=

# ─── ابطال گروهی نشست ────────────────────
# نشست‌ها به‌صورت خودکار با تغییر رمز، نام کاربری، کلید TOTP یا
# کلید امضا باطل می‌شوند.
#
# اگر بدون تغییر هیچ‌کدام می‌خواهید همه را بیرون بیندازید (مثلاً
# شک دارید کوکی جایی لو رفته)، این مقدار را عوض کنید:
# ADMIN_SESSION_VERSION=1

# ─── نقش مدیر (RBAC — فاز B) ─────────────
# سه نقش پشتیبانی می‌شود:
#   viewer   — فقط خواندن. مناسب برای حسابرس یا نظارت
#   operator — عملیات روزمره (سفارش، مشتری، محتوا، کمپین)
#              ولی نه finance/settings/users
#   admin    — همه‌کاره
#
# پیش‌فرض: admin (رفتار سازگار با نسخه‌های قبلی).
# ⚠️ تغییر این مقدار همهٔ نشست‌های موجود را ابطال می‌کند
#    (بخشی از fingerprint نشست است).
# ADMIN_ROLE=admin

# ─── ورود دومرحله‌ای (TOTP) ──────────────
# اگر تعریف شود، ورود بدون کد شش‌رقمی ممکن نخواهد بود.
#
#   npm run admin:totp
#
# ⚠️ کلید را جای امنی نگه دارید. اگر هم گوشی و هم کلید را از
#    دست بدهید، برای بازگشت باید همین خط را حذف کنید.
# ADMIN_TOTP_SECRET=

# ─── محدودیت نرخ ─────────────────────────
# شمارندهٔ تلاش‌های ناموفق روی دیسک ذخیره می‌شود تا با ری‌استارت
# و deploy پاک نشود. پیش‌فرض: <ریشهٔ پروژه>/.data/
#
# روی هاست با فایل‌سیستم فقط-خواندنی، مسیر یک volume نوشتنی بدهید.
# اگر ممکن نبود، ماژول بی‌صدا به حالت حافظه‌ای برمی‌گردد.
# RATE_LIMIT_STORE_PATH=/var/lib/saite/rate-limit.json

# ─── پراکسی معکوس ────────────────────────
# 🔴 اگر پشت nginx / Cloudflare / Vercel هستید حتماً تنظیم کنید.
#
# هدر x-forwarded-for را هر کسی می‌تواند جعل کند. بدون این مقدار،
# مهاجم با عوض کردن یک هدر هر بار سطل جدید می‌گیرد و محدودیت نرخ
# عملاً بی‌اثر است.
#
#   1 = یک پراکسی (nginx یا Cloudflare)
#   2 = دو لایه (Cloudflare + nginx)
# TRUSTED_PROXY_HOPS=1

# ══════════════════════════════════════════
#  بک‌اند — فاز ۱ (C0+C1)
# ══════════════════════════════════════════

# ─── دیتابیس ─────────────────────────────
# اگر خالی بماند: سیستم بالا نمی‌آید (الزامی از فاز ۱)
# فرمت: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:saite_dev_only@localhost:5432/saite_dev

# ─── Redis ───────────────────────────────
# اگر خالی بماند: rate-limit و queue غیرفعال می‌شوند
REDIS_URL=redis://localhost:6379

# ─── لایهٔ داده (فرانت) ──────────────────
# پیش‌فرض: mock داخلی. برای HTTP واقعی:
# NEXT_PUBLIC_USE_MOCK=false
# NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
#
# نکته: اگر base URL روی دامنهٔ دیگری باشد، همان origin به‌صورت
# خودکار به connect-src در CSP اضافه می‌شود (src/lib/security-headers.ts).
NEXT_PUBLIC_USE_MOCK=true
# NEXT_PUBLIC_API_BASE_URL=

# ─── سئو / گوگل (سرورمحور — بدون NEXT_PUBLIC) ──
# تأیید Search Console: مقدار meta verification (در HTML عمومی می‌آید، ولی در باندل JS نه)
# GOOGLE_SITE_VERIFICATION=
# شناسهٔ اندازه‌گیری GA4 مثل G-XXXXXXXX — اسنیپت فقط پس از رضایت کوکی بار می‌شود
# GA4_MEASUREMENT_ID=

# ─── ابزار سئوی پولی (سرورمحور — بدون NEXT_PUBLIC) ──
# پیش‌فرض خاموش. بدون کلید، بررسی کلمهٔ کلیدی با stub کار می‌کند.
# SEO_TOOLS_ENABLED=false
# AHREFS_API_KEY=
# SEMRUSH_API_KEY=
# SEO_TOOLS_COUNTRY=ir
# SEMRUSH_DATABASE=us

# ─── AI (Claude + OpenAI) ────────────────
# در development/test اگر خالی باشد MockAiProvider فعال است.
# 🔴 در production نبود کلید، سرویس AI/embedding را با 503 متوقف می‌کند.
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxx  # ← کلید واقعی خودت را بگذار
# OPENAI_API_KEY=sk-xxxxxxxxxxxx         # ← فقط برای embeddings
# HTTPS_PROXY=                           # ← اگر از IP ایران به Anthropic دسترسی نداری

# ─── پرداخت (زرین‌پال / IDPay) ───────────
# اگر خالی: MockPaymentProvider فعال می‌شود (همیشه success، فقط لاگ)
# ZARINPAL_MERCHANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# IDPAY_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# PAYMENT_SANDBOX=true

# ─── ایمیل ───────────────────────────────
# فاز ۱: ConsoleMailProvider (فقط لاگ، ایمیل واقعی ارسال نمی‌شود)
# فاز ۲: SMTP ایرانی
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-smtp-user
# SMTP_PASS=your-smtp-password

# ─── SMS ─────────────────────────────────
# فاز ۱: ConsoleSmsProvider (فقط لاگ)
# فاز ۲: Kavenegar / Melipayamak
# KAVENEGAR_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── آپلود تصاویر ────────────────────────
# فاز ۱: local (public/uploads/)
# فاز ۲: ArvanCloud S3-compatible
# UPLOAD_PROVIDER=local
# ARVAN_S3_ENDPOINT=https://s3.ir-thr-at1.arvanstorage.ir
# ARVAN_S3_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxx
# ARVAN_S3_SECRET_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# ARVAN_S3_BUCKET=saite-uploads

# ─── احراز هویت مشتری ────────────────────
# پکیج next-auth نصب نیست؛ احراز هویت مشتری هنوز mock است.
# NEXTAUTH_URL=http://localhost:3000
# NEXTAUTH_SECRET=
