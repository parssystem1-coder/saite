{
  "name": "saite",
  "version": "0.1.0",
  "private": true,
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src --max-warnings=0",
    "type-check": "tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run type-check && npm run lint && npm run test && npm run build",
    "lint:fix": "eslint src --fix",
    "admin:check": "node scripts/admin-setup.mjs check",
    "admin:hash-password": "node scripts/admin-setup.mjs hash-password",
    "admin:totp": "node scripts/admin-setup.mjs totp",
    "admin:secret": "node scripts/admin-setup.mjs secret",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report",
    "e2e:list": "playwright test --list"
  },
  "dependencies": {
    "@fontsource/vazirmatn": "^5.3.0",
    "@hookform/resolvers": "5.5.7",
