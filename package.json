    "@tiptap/extension-underline": "^3.29.2",
    "@tiptap/react": "^3.29.2",
    "@tiptap/starter-kit": "^3.29.2",
    "bullmq": "^6.0.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.43.0",
    "ioredis": "^6.0.0",
    "lucide-react": "^1.28.0",
    "next": "16.2.12",
    "pino": "^10.3.1",
    "prisma": "^6.19.3",
    "react": "19.2.4",
