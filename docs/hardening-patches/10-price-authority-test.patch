--- a/tests/lib/price-authority.test.ts
+++ b/tests/lib/price-authority.test.ts
@@ -0,0 +1,89 @@
+import { describe, expect, it } from 'vitest'
+import { repriceCart } from '@/lib/checkout/price-authority'
+import { PRODUCTS } from '@/lib/mock-data'
+
+/**
+ * مرجع قیمت.
+ *
+ * ── چرا این تست‌ها لازم‌اند ───────────────────────────────────
+ * سبد خرید در localStorage است. یعنی قیمتی که از کلاینت می‌آید
+ * دادهٔ **کاربر** است. این تست‌ها ادعا می‌کنند که هیچ مسیری وجود
+ * ندارد که عدد کلاینت به مبلغ نهایی نشت کند.
+ */
+
+const fixedProduct = PRODUCTS.find((p) => p.priceType === 'fixed' && p.price !== undefined)!
+const quoteProduct = PRODUCTS.find((p) => p.priceType === 'quote_only')
+
+describe('قیمت‌گذاری مجدد', () => {
+  it('قیمت را از منبع داده می‌خواند نه از ورودی', async () => {
+    const result = await repriceCart([{ id: fixedProduct.id, quantity: 2 }])
+
+    expect(result.lines).toHaveLength(1)
+    expect(result.lines[0].unitPrice).toBe(fixedProduct.price)
+    expect(result.total).toBe(fixedProduct.price! * 2)
+  })
+
+  it('🔑 امضای تابع اصلاً قیمت نمی‌پذیرد', async () => {
+    /*
+      این تست شکل قرارداد را قفل می‌کند: اگر روزی کسی `price` را
+      به CartLine اضافه کند و اینجا استفاده‌اش کند، خروجی عوض
+      می‌شود و تست قرمز می‌شود.
+    */
+    const tampered = { id: fixedProduct.id, quantity: 1, price: 1 } as never
+    const result = await repriceCart([tampered])
+
+    expect(result.total).toBe(fixedProduct.price)
+    expect(result.total).not.toBe(1)
+  })
+
+  it('ردیف‌های تکراری ادغام می‌شوند', async () => {
+    // وگرنه کلاینت با تکرار id سقف تعداد را دور می‌زند
+    const result = await repriceCart([
+      { id: fixedProduct.id, quantity: 1 },
+      { id: fixedProduct.id, quantity: 2 },
+    ])
+
+    expect(result.lines).toHaveLength(1)
+    expect(result.lines[0].quantity).toBe(3)
+  })
+
+  it('تعداد نامعتبر رد می‌شود', async () => {
+    const result = await repriceCart([
+      { id: fixedProduct.id, quantity: 0 },
+      { id: fixedProduct.id, quantity: -5 },
+    ])
+
+    expect(result.lines).toHaveLength(0)
+    expect(result.total).toBe(0)
+    expect(result.rejected.every((r) => r.reason === 'invalid-quantity')).toBe(true)
+  })
+
+  it('تعداد کسری به عدد صحیح تبدیل می‌شود', async () => {
+    const result = await repriceCart([{ id: fixedProduct.id, quantity: 2.9 }])
+    expect(result.lines[0].quantity).toBe(2)
+  })
+
+  it('سقف تعداد هر ردیف اعمال می‌شود', async () => {
+    const result = await repriceCart([{ id: fixedProduct.id, quantity: 9999 }])
+    expect(result.lines[0].quantity).toBeLessThanOrEqual(20)
+  })
+
+  it('کالای ناموجود در منبع داده رد می‌شود', async () => {
+    const result = await repriceCart([{ id: 'این-شناسه-وجود-ندارد', quantity: 1 }])
+
+    expect(result.lines).toHaveLength(0)
+    expect(result.rejected[0].reason).toBe('not-found')
+  })
+
+  it('سبد خالی مبلغ صفر می‌دهد', async () => {
+    const result = await repriceCart([])
+    expect(result).toEqual({ lines: [], rejected: [], total: 0 })
+  })
+
+  it.runIf(quoteProduct)('کالای استعلامی وارد فاکتور نمی‌شود', async () => {
+    const result = await repriceCart([{ id: quoteProduct!.id, quantity: 1 }])
+
+    expect(result.lines).toHaveLength(0)
+    expect(result.rejected[0].reason).toBe('quote-only')
+  })
+})
