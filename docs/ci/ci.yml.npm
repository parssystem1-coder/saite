name: CI

on:
  push:
    branches: [main, 'arena/**']
  pull_request:
    branches: [main]

# اگر کامیت جدیدی روی همان برنچ پوش شود، اجرای قبلی لغو می‌شود
# تا دقیقه‌های Actions هدر نرود.
concurrency:
  group: ${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

jobs:
  verify:
    runs-on: ubuntu-latest
    timeout-minutes: 15

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Set up Node.js
        uses: actions/setup-node@v4
        with:
          node-version: 22
          cache: 'npm'

      # npm ci از package-lock.json می‌خواند و نصب تکرارپذیر می‌دهد.
      # پیش از این CI با pnpm نصب می‌کرد در حالی که تیم با npm کار
      # می‌کند — دو درخت وابستگی متفاوت، دو نتیجهٔ متفاوت.
      - name: Install dependencies
        run: npm ci --no-audit --no-fund

      - name: Type check
        run: npm run type-check

      - name: Lint
        run: npm run lint

      - name: Test
        run: npm test

      - name: Build
        run: npm run build
