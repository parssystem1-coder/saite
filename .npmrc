# ─────────────────────────────────────────────────────────
# پیکربندی npm برای این پروژه
#
# نکته: کلیدهای مخصوص pnpm (مثل minimum-release-age و
# network-concurrency) حذف شدند، چون npm آن‌ها را نمی‌شناسد و در هر
# اجرا هشدار «Unknown project config» می‌داد.
# ─────────────────────────────────────────────────────────

# ── پایداری دانلود ───────────────────────────────────────
# بستهٔ next حدود ۳۵ مگابایت و کامپایلر SWC ویندوز حدود ۴۴ مگابایت
# است. روی اتصال‌های کند یا ناپایدار، مهلت پیش‌فرض کافی نیست و
# دانلود وسط کار با خطای «error (23)» قطع می‌شود.

# مهلت هر درخواست: ۱۵ دقیقه
fetch-timeout=900000

# تعداد تلاش مجدد در صورت قطع شدن
fetch-retries=5

# فاصلهٔ بین تلاش‌ها (۱۰ ثانیه تا ۲ دقیقه، به‌صورت تصاعدی)
fetch-retry-mintimeout=10000
fetch-retry-maxtimeout=120000

# کاهش اتصال‌های هم‌زمان به رجیستری.
# روی اتصال محدود، پهنای باند بین درخواست‌های موازی تقسیم می‌شود و
# بسته‌های سنگین قبل از مهلت تمام نمی‌شوند. معادل npm برای
# network-concurrency در pnpm.
maxsockets=3

# خروجی تمیزتر هنگام نصب
fund=false
audit=false
