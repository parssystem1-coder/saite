# ─────────────────────────────────────────────────────────
# پیکربندی pnpm برای این پروژه
# ─────────────────────────────────────────────────────────

# سیاست minimumReleaseAge بستهٔ تازه‌منتشرشده را رد می‌کند تا از
# حملات زنجیرهٔ تأمین (supply-chain) جلوگیری شود. این سیاست خوب است،
# اما اگر lockfile شامل بسته‌ای باشد که همان روز منتشر شده،
# نصب روی سیستم دیگران شکست می‌خورد.
#
# راهکار ما: تمام وابستگی‌ها روی نسخه‌هایی پین شده‌اند که بیش از یک
# هفته از انتشارشان گذشته است. مقدار زیر همان سیاست را صریح و
# یکسان برای همهٔ اعضای تیم تعریف می‌کند.
minimum-release-age=10080

# اجازهٔ عبور از سیاست برای بسته‌های هستهٔ فریم‌ورک در صورت نیاز فوری
# minimum-release-age-exclude=next

# نصب دقیق نسخه‌ها هنگام pnpm add — از ورود ناخواستهٔ نسخهٔ جدید
# جلوگیری می‌کند
save-exact=false
