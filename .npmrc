# ─────────────────────────────────────────────────────────
# پیکربندی pnpm برای این پروژه
# ─────────────────────────────────────────────────────────

# ── امنیت زنجیرهٔ تأمین ──────────────────────────────────
# بستهٔ تازه‌منتشرشده رد می‌شود تا اگر حساب توسعه‌دهنده‌ای هک شد و
# نسخهٔ آلوده منتشر کرد، ما در آن پنجرهٔ خطر نصب نکنیم.
# تمام وابستگی‌ها روی نسخه‌هایی پین شده‌اند که از این آستانه گذشته‌اند.
minimum-release-age=10080

# ── پایداری دانلود ───────────────────────────────────────
# بستهٔ next حدود ۳۵ مگابایت و کامپایلر SWC ویندوز حدود ۴۴ مگابایت
# است. روی اتصال‌های کند یا ناپایدار، مهلت پیش‌فرض (۶۰ ثانیه) کافی
# نیست و دانلود وسط کار با خطای «error (23)» قطع می‌شود.

# مهلت هر درخواست: ۱۵ دقیقه به‌جای ۶۰ ثانیه
fetch-timeout=900000

# تعداد تلاش مجدد در صورت قطع شدن
fetch-retries=5

# فاصلهٔ بین تلاش‌ها (۱۰ ثانیه تا ۲ دقیقه، به‌صورت تصاعدی)
fetch-retry-mintimeout=10000
fetch-retry-maxtimeout=120000

# کاهش تعداد دانلود هم‌زمان.
# پیش‌فرض ۱۶ است؛ روی اتصال محدود، پهنای باند بین ۱۶ فایل تقسیم
# می‌شود و هیچ‌کدام قبل از مهلت تمام نمی‌شوند. با عدد ۲، دو بستهٔ
# سنگین next و swc تقریباً تمام پهنای باند را می‌گیرند.
network-concurrency=2
